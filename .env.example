# WhatsApp target group JID, discovered with:
# npm run dev -- list-groups
WHATSAPP_GROUP_JID=

# Bhagavad Gita API source. The bot fetches /slok/{chapter}/{verse}/ at send time.
GITA_API_BASE_URL=https://vedicscriptures.github.io
GITA_API_TIMEOUT_MS=10000
# Preferred Hindi meaning field in the API response. If absent, first valid Hindi meaning is used.
GITA_HINDI_FIELD=tej.ht

# Daily schedule in 24-hour local time.
GITA_VERSES_PER_DAY=2
GITA_TIME=06:00
TZ=Asia/Kolkata

# Poll for missed sends after GITA_TIME (within a 4-hour window). Default: true.
GITA_CATCH_UP=true

# Pairing is usually easiest on a VPS. Use only digits with country code.
AUTH_METHOD=pairing
PAIRING_PHONE_NUMBER=919876543210

# Runtime paths. Defaults are shown here for clarity.
DATA_DIR=./data
AUTH_DIR=./data/auth
STATE_FILE=./data/state.json

# Logging: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info

# --- Health webhook (Apple Shortcuts → WhatsApp) ---
# When enabled, the serve process also runs an HTTP server that accepts a daily
# health payload from an Apple Shortcut, stores it, and posts a Hindi report.
HEALTH_WEBHOOK_ENABLED=false
# Port the webhook listens on (Fly maps 443/80 → this internal port).
HEALTH_WEBHOOK_PORT=8080
# Long random secret. Send it as `Authorization: Bearer <token>` or `x-webhook-token`.
HEALTH_WEBHOOK_TOKEN=
# Group(s) to post health reports to. Comma-separated to post to multiple
# groups (e.g. two family groups). Falls back to WHATSAPP_GROUP_JID when unset.
# HEALTH_GROUP_JID=120363111...@g.us,120363222...@g.us
HEALTH_GROUP_JID=
# Daily steps goal used for the ✅ mark and the streak insight.
HEALTH_STEP_GOAL=9000
# Daily sleep goal used for the ✅ mark.
HEALTH_SLEEP_GOAL_HOURS=7
